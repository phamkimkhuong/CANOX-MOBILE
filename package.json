{
  "name": "canox",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage --runInBand --watchAll=false",
    "test:adapter": "jest --testPathPattern=\"__tests__/utils/adapter\"",
    "test:store": "jest --testPathPattern=\"__tests__/store\"",
    "test:hook": "jest --testPathPattern=\"__tests__/hooks\"",
    "test:component": "jest --testPathPattern=\"__tests__/components\"",
    "test:screen": "jest --testPathPattern=\"__tests__/screens\"",
    "test:api": "cross-env RUN_API_CONTRACT_TESTS=true jest --runInBand --watchAll=false __tests__/api-contract",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "start": "expo start",
    "clear": "expo start --clear",
    "prebuild": "expo prebuild --clean",
    "a": "expo run:android",
    "a-dev": "cross-env APP_VARIANT=development expo run:android --device",
    "a-dev-prebuild": "cross-env APP_VARIANT=development npx expo prebuild --platform android --clean && expo run:android --device",
    "a-prod-prebuild": "npx expo prebuild --platform android --clean && cd android && gradlew.bat assembleRelease",
    "a-preview-install": "cross-env APP_VARIANT=preview npx expo prebuild --platform android --clean && cd android && gradlew.bat installRelease",
    "a-prod-install": "npx expo prebuild --platform android --clean && cd android && gradlew.bat installRelease",
    "build-dev": "eas build --profile development --platform android",
    "build-preview": "eas build --profile preview --platform android",
    "build-prod": "eas build --profile production --platform android",
    "ios": "cross-env APP_VARIANT=development expo run:ios",
    "ios-dev": "cross-env APP_VARIANT=development npx expo prebuild --platform ios --clean && expo run:ios",
    "ios-preview": "cross-env APP_VARIANT=preview expo run:ios",
    "android": "expo run:android"
  },
  "dependencies": {
    "@expo/ui": "~57.0.3",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "5.2.8",
    "@hookform/resolvers": "^5.4.0",
    "@react-native-firebase/analytics": "^23.8.6",
    "@react-native-firebase/app": "^23.8.6",
    "@react-native-firebase/messaging": "^23.8.6",
    "@react-native-firebase/remote-config": "^23.8.6",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native/normalize-colors": "^0.86.0",
    "@react-navigation/bottom-tabs": "^7.18.7",
    "@react-navigation/elements": "^2.9.29",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "^2.3.2",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.13.6",
    "expo": "^57.0.2",
    "expo-application": "~57.0.0",
    "expo-blur": "~57.0.0",
    "expo-clipboard": "~57.0.0",
    "expo-constants": "~57.0.3",
    "expo-dev-client": "~57.0.5",
    "expo-device": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-image-picker": "~57.0.2",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.1",
    "expo-local-authentication": "~57.0.0",
    "expo-localization": "~57.0.0",
    "expo-network": "~57.0.0",
    "expo-notifications": "~57.0.3",
    "expo-router": "~57.0.3",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-updates": "~57.0.6",
    "expo-video": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "i18next": "^26.3.4",
    "js-md5": "0.8.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "^6.1.2",
    "react-freeze": "1.0.4",
    "react-hook-form": "^7.81.0",
    "react-i18next": "16.5.0",
    "react-native": "0.86.0",
    "react-native-awesome-gallery": "0.4.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-qrcode-svg": "6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-render-html": "6.3.4",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "^15.15.5",
    "react-native-toast-message": "2.3.3",
    "react-native-unistyles": "3.2.5",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "^0.10.2",
    "rn-emoji-keyboard": "1.7.0",
    "sockjs-client": "1.6.1",
    "text-encoding-polyfill": "0.6.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@ivotoby/openapi-mcp-server": "^1.12.4",
    "@mswjs/interceptors": "^0.41.4",
    "@react-native/eslint-config": "^0.86.0",
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^26.1.0",
    "@types/react": "~19.2.10",
    "@types/sockjs-client": "^1.5.4",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-i18next": "^6.1.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-testing-library": "^7.16.0",
    "expo-build-properties": "~57.0.3",
    "globals": "^17.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.1",
    "msw": "^1.3.5",
    "react-test-renderer": "^19.2.3",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.(test|spec).(ts|tsx)",
      "**/?(*.)+(test|spec).(ts|tsx)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native|expo(nent)?|@expo(nent)?/.*|expo-router|@react-navigation/.*|@sentry/.*))"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/",
      "/dist/"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated"
      ]
    }
  },
  "private": true
}