{
  "name": "canox",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage --runInBand --watchAll=false",
    "test:api": "cross-env RUN_API_CONTRACT_TESTS=true jest --runInBand --watchAll=false __tests__/api-contract",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "start": "expo start",
    "clear": "expo start --clear",
    "pre": "expo prebuild",
    "android": "expo run:android",
    "a": "cross-env APP_VARIANT=development expo run:android --device",
    "a-dev": "cross-env APP_VARIANT=development npx expo prebuild --platform android --clean && expo run:android --device",
    "a-prod": "npx expo prebuild --platform android --clean && cd android && gradlew.bat assembleRelease",
    "a-preview-ins": "cross-env APP_VARIANT=preview npx expo prebuild --platform android --clean && cd android && gradlew.bat installRelease",
    "a-prod-ins": "npx expo prebuild --platform android --clean && cd android && gradlew.bat installRelease",
    "build-dev": "eas build --profile development --platform android",
    "build-preview": "eas build --profile preview --platform android",
    "build-prod": "eas build --profile production --platform android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.3",
    "@gorhom/bottom-sheet": "5.2.8",
    "@hookform/resolvers": "5.2.2",
    "@notifee/react-native": "9.1.8",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-firebase/analytics": "23.8.6",
    "@react-native-firebase/app": "23.8.6",
    "@react-native-firebase/crashlytics": "23.8.6",
    "@react-native-firebase/messaging": "23.8.6",
    "@react-native-firebase/perf": "23.8.6",
    "@react-native-firebase/remote-config": "23.8.6",
    "@react-native-google-signin/google-signin": "16.1.1",
    "@react-native/normalize-colors": "0.83.1",
    "@react-navigation/native": "7.1.26",
    "@shopify/flash-list": "2.0.2",
    "@stomp/stompjs": "7.2.1",
    "@tanstack/react-query": "5.90.12",
    "axios": "1.13.2",
    "expo": "~54.0.31",
    "expo-application": "~7.0.8",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "17.0.8",
    "expo-localization": "~17.0.8",
    "expo-router": "~6.0.21",
    "expo-secure-store": "15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.16",
    "expo-video": "~3.0.15",
    "expo-web-browser": "~15.0.10",
    "i18next": "25.7.3",
    "js-md5": "0.8.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-error-boundary": "6.0.3",
    "react-freeze": "1.0.4",
    "react-hook-form": "7.68.0",
    "react-i18next": "16.5.0",
    "react-native": "0.81.5",
    "react-native-awesome-gallery": "0.4.3",
    "react-native-edge-to-edge": "1.7.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-mmkv": "4.1.0",
    "react-native-nitro-modules": "0.31.10",
    "react-native-qrcode-svg": "6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-render-html": "6.3.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-toast-message": "2.3.3",
    "react-native-unistyles": "3.0.19",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "rn-emoji-keyboard": "1.7.0",
    "sockjs-client": "1.6.1",
    "text-encoding-polyfill": "0.6.7",
    "zod": "4.2.1",
    "zustand": "5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@ivotoby/openapi-mcp-server": "^1.12.4",
    "@react-native/eslint-config": "^0.83.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "@types/sockjs-client": "^1.5.4",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-i18next": "^6.1.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-testing-library": "^7.16.0",
    "globals": "^17.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.53.1"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.(test|spec).(ts|tsx)",
      "**/?(*.)+(test|spec).(ts|tsx)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native|expo(nent)?|@expo(nent)?/.*|expo-router|@react-navigation/.*))"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/",
      "/dist/"
    ]
  },
  "private": true
}
