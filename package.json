{
  "name": "canox",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage --runInBand --watchAll=false",
    "test:adapter": "jest --testPathPattern=\"__tests__/utils/adapter\"",
    "test:store": "jest --testPathPattern=\"__tests__/store\"",
    "test:hook": "jest --testPathPattern=\"__tests__/hooks\"",
    "test:component": "jest --testPathPattern=\"__tests__/components\"",
    "test:screen": "jest --testPathPattern=\"__tests__/screens\"",
    "test:api": "cross-env RUN_API_CONTRACT_TESTS=true jest --runInBand --watchAll=false __tests__/api-contract",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "start": "expo start",
    "clear": "expo start --clear",
    "prebuild": "expo prebuild --clean",
    "a": "expo run:android",
    "a-dev": "cross-env APP_VARIANT=development expo run:android --device",
    "a-dev-prebuild": "cross-env APP_VARIANT=development npx expo prebuild --platform android --clean && expo run:android --device",
    "a-prod-prebuild": "npx expo prebuild --platform android --clean && cd android && gradlew.bat assembleRelease",
    "a-preview-install": "cross-env APP_VARIANT=preview npx expo prebuild --platform android --clean && cd android && gradlew.bat installRelease",
    "a-prod-install": "npx expo prebuild --platform android --clean && cd android && gradlew.bat installRelease",
    "build-dev": "eas build --profile development --platform android",
    "build-preview": "eas build --profile preview --platform android",
    "build-prod": "eas build --profile production --platform android",
    "ios": "cross-env APP_VARIANT=development expo run:ios",
    "ios-dev": "cross-env APP_VARIANT=development npx expo prebuild --platform ios --clean && expo run:ios",
    "ios-preview": "cross-env APP_VARIANT=preview expo run:ios",
    "android": "expo run:android"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.3",
    "@gorhom/bottom-sheet": "5.2.8",
    "@hookform/resolvers": "5.2.2",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-firebase/analytics": "^23.8.6",
    "@react-native-firebase/app": "^23.8.6",
    "@react-native-firebase/messaging": "^23.8.6",
    "@react-native-firebase/remote-config": "^23.8.6",
    "@react-native-google-signin/google-signin": "16.1.1",
    "@react-native/normalize-colors": "0.83.1",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@stomp/stompjs": "7.2.1",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.13.6",
    "expo": "~55.0.23",
    "expo-application": "~55.0.15",
    "expo-blur": "~55.0.14",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.14",
    "expo-dev-client": "~55.0.35",
    "expo-device": "~55.0.17",
    "expo-file-system": "~55.0.16",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.20",
    "expo-linear-gradient": "~55.0.14",
    "expo-linking": "~55.0.15",
    "expo-local-authentication": "~55.0.14",
    "expo-localization": "~55.0.15",
    "expo-network": "~55.0.14",
    "expo-notifications": "~55.0.23",
    "expo-router": "~55.0.16",
    "expo-secure-store": "~55.0.14",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.18",
    "expo-updates": "~55.0.24",
    "expo-video": "~55.0.17",
    "expo-web-browser": "~55.0.16",
    "i18next": "^26.3.4",
    "js-md5": "0.8.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-error-boundary": "^6.1.2",
    "react-freeze": "1.0.4",
    "react-hook-form": "^7.81.0",
    "react-i18next": "16.5.0",
    "react-native": "0.83.6",
    "react-native-awesome-gallery": "0.4.3",
    "react-native-edge-to-edge": "1.7.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-mmkv": "4.1.0",
    "react-native-nitro-modules": "0.31.10",
    "react-native-qrcode-svg": "6.3.21",
    "react-native-reanimated": "4.2.1",
    "react-native-render-html": "6.3.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-toast-message": "2.3.3",
    "react-native-unistyles": "3.0.19",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "rn-emoji-keyboard": "1.7.0",
    "sockjs-client": "1.6.1",
    "text-encoding-polyfill": "0.6.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@ivotoby/openapi-mcp-server": "^1.12.4",
    "@mswjs/interceptors": "^0.41.4",
    "@react-native/eslint-config": "^0.83.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "@types/sockjs-client": "^1.5.4",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-i18next": "^6.1.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-testing-library": "^7.16.0",
    "expo-build-properties": "~55.0.14",
    "globals": "^17.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.17",
    "msw": "^1.3.5",
    "react-test-renderer": "^19.2.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.63.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.(test|spec).(ts|tsx)",
      "**/?(*.)+(test|spec).(ts|tsx)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native|expo(nent)?|@expo(nent)?/.*|expo-router|@react-navigation/.*|@sentry/.*))"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/",
      "/dist/"
    ]
  },
  "private": true
}
